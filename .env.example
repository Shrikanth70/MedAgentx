APP_NAME=MedAgentX
APP_ENV=development
LOG_LEVEL=INFO

LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=mock-api-key-for-testing

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=medagentx

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=medagentx_password

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=medagentx
POSTGRES_USER=medagentx
POSTGRES_PASSWORD=medagentx_password

REDIS_URL=redis://localhost:6379/0

VECTOR_TOP_K=5
MAX_RETRIEVAL_ITERATIONS=2

CONFIDENCE_HIGH_THRESHOLD=0.80
CONFIDENCE_LOW_THRESHOLD=0.50

RANDOM_SEED=42
TEMPERATURE=0.0
